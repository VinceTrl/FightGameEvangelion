code = "shader_type spatial;
render_mode blend_add, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D sprite_texture;
uniform vec4 Background_Color : source_color = vec4(0.000000, 0.000000, 0.000000, 0.000000);
uniform vec4 Blinking_Color : source_color = vec4(1.000000, 1.000000, 1.000000, 1.000000);
uniform float Blinking_Speed = 10.0;
uniform float Blinking_Intensity = 1.0;



void fragment() {
	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(sprite_texture, UV);


// ColorParameter:16
	vec4 n_out16p0 = Background_Color;


// ColorParameter:14
	vec4 n_out14p0 = Blinking_Color;


// Input:6
	float n_out6p0 = TIME;


// FloatParameter:8
	float n_out8p0 = Blinking_Speed;


// FloatOp:7
	float n_out7p0 = n_out6p0 * n_out8p0;


// FloatFunc:5
	float n_out5p0 = sin(n_out7p0);


// FloatOp:18
	float n_in18p1 = 0.50000;
	float n_out18p0 = n_out5p0 + n_in18p1;


// FloatOp:19
	float n_in19p1 = 2.00000;
	float n_out19p0 = n_out18p0 / n_in19p1;


// Mix:17
	vec4 n_out17p0 = mix(n_out16p0, n_out14p0, vec4(n_out19p0));


// FloatParameter:11
	float n_out11p0 = Blinking_Intensity;


// VectorOp:20
	vec4 n_out20p0 = n_out17p0 * vec4(n_out11p0);


// VectorOp:9
	vec4 n_out9p0 = n_out3p0 * n_out20p0;


// VectorDecompose:4
	float n_out4p0 = n_out9p0.x;
	float n_out4p1 = n_out9p0.y;
	float n_out4p2 = n_out9p0.z;
	float n_out4p3 = n_out9p0.w;


// FloatFunc:15
	float n_out15p0 = min(max(n_out4p3, 0.0), 1.0);


// Output:0
	ALBEDO = vec3(n_out9p0.xyz);
	ALPHA = n_out15p0;


}
"
