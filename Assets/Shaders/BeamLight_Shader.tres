// FloatParameter:15
	float n_out15p0 = Intensity;


// VectorOp:14
	vec3 n_out14p0 = n_out12p0 * vec3(n_out15p0);


// Output:0
	ALBEDO = vec3(n_out16p0.xyz);
	EMISSION = n_out14p0;


}
