[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_toon, specular_toon;

uniform vec4 AlbedoMult : source_color = vec4(1.000000, 1.000000, 1.000000, 1.000000);
uniform sampler2D Albedo : hint_default_black;
uniform vec4 AlbedoPower = vec4(1.000000, 1.000000, 1.000000, 1.000000);
uniform vec4 EmissiveMult : source_color = vec4(1.000000, 1.000000, 1.000000, 1.000000);
uniform sampler2D Emissive : hint_default_black;
uniform vec4 AlbedoPower2 = vec4(1.000000, 1.000000, 1.000000, 1.000000);



void fragment() {
// ColorParameter:7
	vec4 n_out7p0 = AlbedoMult;


	vec4 n_out4p0;
// Texture2D:4
	n_out4p0 = texture(Albedo, UV);


// Vector4Parameter:13
	vec4 n_out13p0 = AlbedoPower;


// VectorOp:12
	vec4 n_out12p0 = pow(n_out4p0, n_out13p0);


// VectorOp:6
	vec4 n_out6p0 = n_out7p0 * n_out12p0;
	float n_out6p4 = n_out6p0.a;


// ColorParameter:10
	vec4 n_out10p0 = EmissiveMult;


	vec4 n_out8p0;
// Texture2D:8
	n_out8p0 = texture(Emissive, UV);


// Vector4Parameter:14
	vec4 n_out14p0 = AlbedoPower2;


// VectorOp:15
	vec4 n_out15p0 = pow(n_out8p0, n_out14p0);


// VectorOp:9
	vec4 n_out9p0 = n_out10p0 * n_out15p0;


// Output:0
	ALBEDO = vec3(n_out6p0.xyz);
	ALPHA = n_out6p4;
	EMISSION = vec3(n_out9p0.xyz);


}
"
